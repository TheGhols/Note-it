#!/usr/bin/env bash
# Fails if the headless TUI ever gains a desktop UI, network or async runtime dependency.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

tree="$(cargo tree -p noteit-tui --edges normal --prefix none)"

FORBIDDEN_PATTERN='^(gtk4|gdk4|webkit6|gtk4-layer-shell|wayland($|-)|niri($|-)|tokio($|-)|hyper($|-)|reqwest($|-)|ureq($|-)|curl($|-))( |$)'

if grep -Eq "$FORBIDDEN_PATTERN" <<<"$tree"; then
  printf '%s\n' "TUI boundary violation: noteit-tui depends on forbidden desktop, network, or async runtime crates (gtk, gdk, webkit, layer-shell, wayland, niri, tokio, hyper, reqwest, ureq, curl)." >&2
  grep -E "$FORBIDDEN_PATTERN" <<<"$tree" >&2
  exit 1
fi

if grep -En '(serde_yaml|std::fs::read_dir)' noteit-tui/src/*.rs >/dev/null 2>&1; then
  printf '%s\n' "TUI boundary violation: noteit-tui/src contains direct YAML parsing or directory traversal; all store access must pass through noteit-core." >&2
  exit 1
fi

# docs/tui.md property 23 (§27.20), made mechanical.
#
# The hazard §26.16 names is *recognition*: the reader's parser discards
# delimiters, decodes entities and stops a link destination at the first `)`,
# and founding the lossless projector on it would inherit every one of those.
# So what is forbidden is the recognising code, by name — which also catches a
# re-export or an aliased import that a module-path check would miss.
#
# Deliberately not forbidden: the canonical *spelling* helpers. `wrapper()` and
# the two palettes are a `format!` and two constant tables; they parse nothing,
# and sharing them is what guarantees the visual editor writes byte-for-byte
# what the graphical editor and the raw editor write. Two copies of that
# spelling would be the real risk.
PROJECTOR_MODULES=(projection.rs source_map.rs visual.rs visual_edit.rs)
RECOGNISERS='(markdown|inline)::[a-z_]+|::(render_markdown|render_with_sources|inline_spans|comment_width|clear_selected|clear_enclosing)\b|use crate::(markdown|inline)\b|use crate::formatting::\*'

for module in "${PROJECTOR_MODULES[@]}"; do
  path="noteit-tui/src/$module"
  [ -f "$path" ] || continue
  if grep -En "$RECOGNISERS" "$path" >/dev/null 2>&1; then
    printf '%s\n' "TUI boundary violation: $module uses the presentational renderer's recognition code. The lossless projector must not be founded on the reader's parser — see docs/tui.md §26.16 and property 23. Canonical spelling helpers (formatting::wrapper and the palettes) are allowed; parsing and text-search helpers are not." >&2
    grep -En "$RECOGNISERS" "$path" >&2
    exit 1
  fi
done

printf '%s\n' "TUI boundary OK: noteit-tui has no desktop GUI, network or async runtime dependencies, delegates store operations to noteit-core, and the lossless projector does not reference the presentational renderer."
