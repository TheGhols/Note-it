#!/usr/bin/env bash
#
# Every gate this repository has, in one place.
#
# This script is the authority. The CI workflow calls these stages rather than
# restating the commands, so "what has to pass" is one list that lives in the
# repository and not four lists that drift — one in the workflow, one in
# CONTRIBUTING, one in the development guide, one in somebody's memory.
#
# Fail-closed throughout: the first stage that fails stops the run and its
# exit code is the script's exit code. Nothing is ever softened with `|| true`,
# no failure is reported as success, and a missing tool is an error rather than
# a reason to reach for a different one.
#
# `workspace-tests` also covers the isolation harness: `tests/isolation.rs`
# runs `scripts/test-isolation` from inside `cargo test`, so it is not invoked
# a second time here. In a graphical session that harness briefly opens a real
# Note-it window, pointed the whole time at a throwaway store on a private bus.
#
# Usage: scripts/check [all|rust|frontend|<stage>]
#
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT

readonly EXIT_USAGE=2
readonly EXIT_MISSING_TOOL=1

readonly RUST_STAGES=(
  ci-parity
  rust-format
  rust-check
  rust-clippy
  core-boundary
  cli-boundary
  mcp-boundary
  embedding-boundary
  embed-boundary
  core-tests
  cli-tests
  mcp-tests
  embedding-tests
  embed-tests
  remote-tests
  workspace-tests
)

# Asked for by name rather than run by `all`: see stage_offline.
readonly EXTRA_STAGES=(
  offline
)

readonly FRONTEND_STAGES=(
  frontend-install
  frontend-lint
  frontend-test
  frontend-build
)

usage() {
  cat >&2 <<USAGE
Uso: scripts/check [all|rust|frontend|<estágio>]

Agregados:
  all        Rust e frontend (padrão)
  rust       ${RUST_STAGES[*]}
  frontend   ${FRONTEND_STAGES[*]}

Estágios Rust:
  ci-parity        todo estágio desta lista aparece no workflow do CI
  rust-format      cargo fmt --all -- --check
  rust-check       cargo check --workspace
  rust-clippy      cargo clippy --workspace --all-targets --all-features -- -D warnings
  core-boundary    scripts/check-core-boundary
  cli-boundary     scripts/check-cli-boundary
  mcp-boundary     scripts/check-mcp-boundary
  embedding-boundary  scripts/check-embedding-boundary
  embed-boundary   scripts/check-embed-boundary
  offline          scripts/check-offline (exige namespaces de rede sem privilégio)
  core-tests       cargo test -p noteit-core, sem display
  cli-tests        cargo test -p noteit-cli, sem display e sem barramento
  mcp-tests        cargo test -p noteit-mcp, sem display e sem barramento
  embedding-tests  cargo test -p noteit-embedding-local, sem display e sem rede
  embed-tests      cargo test -p noteit-embed, contra um mock local de HTTP
  remote-tests     cargo test -p noteit-embedding-remote e -p noteit-embed-protocol
  workspace-tests  cargo test --workspace (inclui o harness de isolamento)

Estágios do frontend, todos executados em ui/:
  frontend-install  pnpm install --frozen-lockfile
  frontend-lint     pnpm run lint
  frontend-test     pnpm run test
  frontend-build    pnpm run build

Códigos de saída:
  0  tudo o que foi pedido passou
  1  falta uma ferramenta obrigatória
  2  uso inválido
  *  o código do estágio que falhou

Use scripts/doctor antes daqui para saber se a máquina tem o necessário.
USAGE
}

# --- the stages ------------------------------------------------------------

# Every gate in this file has to run on the remote CI too.
#
# This exists because the drift already happened: `embedding-boundary` and
# `embedding-tests` were added here and the workflow was not updated, so two
# gates were green locally and never ran remotely. A list in two places stays
# in agreement only if something checks, so this is the something.
#
# `offline` is exempt by name and not by omission: it needs unprivileged user
# namespaces, which the CI container does not grant, and stage_offline says so.
stage_ci_parity() {
  local workflow="$REPO_ROOT/.github/workflows/ci.yml"
  if [ ! -f "$workflow" ]; then
    echo "check ci-parity: $workflow não existe" >&2
    return 1
  fi
  local missing=()
  local stage
  for stage in "${RUST_STAGES[@]}" "${FRONTEND_STAGES[@]}"; do
    grep -qE "^[[:space:]]*run:[[:space:]]*(\./)?scripts/check $stage[[:space:]]*$" \
      "$workflow" || missing+=("$stage")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo "check ci-parity: estes estágios não são executados por .github/workflows/ci.yml:" >&2
    printf '  %s\n' "${missing[@]}" >&2
    echo "acrescente um passo 'run: scripts/check <estágio>' para cada um." >&2
    return 1
  fi
  echo "ci-parity OK: os ${#RUST_STAGES[@]} estágios Rust e os ${#FRONTEND_STAGES[@]} do frontend aparecem no workflow."
}

stage_rust_format() { cargo fmt --all -- --check; }
stage_rust_check() { cargo check --workspace; }
stage_rust_clippy() { cargo clippy --workspace --all-targets --all-features -- -D warnings; }
stage_core_boundary() { "$REPO_ROOT/scripts/check-core-boundary"; }
stage_cli_boundary() { "$REPO_ROOT/scripts/check-cli-boundary"; }
stage_mcp_boundary() { "$REPO_ROOT/scripts/check-mcp-boundary"; }
stage_embedding_boundary() { "$REPO_ROOT/scripts/check-embedding-boundary"; }
# The 4.3D boundary. It *extends* the three above rather than relaxing any of
# them: HTTP and TLS become legal in exactly one crate, and that crate is
# checked for being unable to do anything else.
stage_embed_boundary() { "$REPO_ROOT/scripts/check-embed-boundary"; }
# Deliberately *not* in the `rust` aggregate. It needs unprivileged user
# namespaces, which a container or a hardened kernel may not give, and a stage
# that quietly passes where it cannot run would be worse than one that has to be
# asked for. `scripts/check offline` runs it.
stage_offline() { "$REPO_ROOT/scripts/check-offline"; }

# The three headless suites are not made redundant by `workspace-tests`. They
# prove a different property: that the Core, the CLI and the MCP server still
# work with no display, no compositor and no session bus at all. Running them
# under the ambient session would prove nothing, so the variables are stripped.
stage_core_tests() {
  env -u DISPLAY -u WAYLAND_DISPLAY cargo test -p noteit-core
}
stage_cli_tests() {
  env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS cargo test -p noteit-cli
}
# The MCP server is spawned by a host and speaks on a pipe. It has to work in a
# session with no display, no compositor and no bus at all, because that is
# where a host will start it.
stage_mcp_tests() {
  env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS cargo test -p noteit-mcp
}
# The local embedding provider, headless like the rest. Its suite builds its own
# synthetic artifacts, so it proves every contract on a machine that has never
# provisioned a model and has no network to do it with — which is the posture
# the factory default is in.
stage_embedding_tests() {
  env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS \
    cargo test -p noteit-embedding-local
}
# The remote worker, against a mock HTTP server on loopback.
#
# `--features test-endpoints` is what redirects the pinned endpoints at that
# mock, and it is why this is a stage of its own rather than part of
# `workspace-tests`: the feature is compiled out of every shipped build, so the
# suite that needs it has to ask for it by name. Without the flag the file
# reports an explicit skip rather than silently running nothing.
#
# No display, no bus, and deliberately *not* `--offline`: nothing here reaches
# the internet, and the proof of that is `scripts/check offline`, which runs a
# suite inside a network namespace with no interface at all.
stage_embed_tests() {
  env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS \
    cargo test -p noteit-embed --features test-endpoints
}
# The client half and the wire, which need no feature and no mock: they speak
# AF_UNIX and describe bytes.
stage_remote_tests() {
  env -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS \
    cargo test -p noteit-embedding-remote -p noteit-embed-protocol
}
stage_workspace_tests() { cargo test --workspace; }

# The project has a pnpm lockfile and the CI uses pnpm. There is deliberately
# no fallback to npm, yarn or bun: a different package manager resolves a
# different tree, and a build that quietly changed its dependencies is worse
# than a build that stopped.
stage_frontend_install() { cd "$REPO_ROOT/ui" && pnpm install --frozen-lockfile; }
stage_frontend_lint() { cd "$REPO_ROOT/ui" && pnpm run lint; }
stage_frontend_test() { cd "$REPO_ROOT/ui" && pnpm run test; }
stage_frontend_build() { cd "$REPO_ROOT/ui" && pnpm run build; }

# --- the one tool a stage cannot start without -----------------------------

# Checked here, before anything runs, because otherwise a missing `cargo` is
# the shell's 127 from inside a stage rather than this script's documented 1 —
# and in an aggregate it would surface halfway through instead of up front.
# This is the whole preflight: everything else about the environment is
# `scripts/doctor`'s question, and this script does not ask it.
require_command() {
  local tool="$1" note="$2"
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'scripts/check: %s não encontrado. %s\n' "$tool" "$note" >&2
    printf 'Use `scripts/doctor` para diagnosticar o ambiente.\n' >&2
    exit "$EXIT_MISSING_TOOL"
  fi
}

# Every Rust stage needs Cargo — the boundary scripts included, since they read
# `cargo tree`. Every frontend stage needs pnpm.
preflight() {
  local name needs_cargo=0 needs_pnpm=0
  for name in "$@"; do
    case "$name" in
      frontend-*) needs_pnpm=1 ;;
      *) needs_cargo=1 ;;
    esac
  done
  if ((needs_cargo)); then
    require_command cargo "Instale a toolchain Rust."
  fi
  if ((needs_pnpm)); then
    require_command pnpm "O projeto usa pnpm; npm e yarn não são alternativas."
  fi
}

# --- running them ----------------------------------------------------------

# The function that implements one stage, by its public name.
stage_function() {
  printf 'stage_%s' "${1//-/_}"
}

is_stage() {
  local candidate="$1" known
  for known in "${RUST_STAGES[@]}" "${FRONTEND_STAGES[@]}" "${EXTRA_STAGES[@]}"; do
    [[ "$candidate" == "$known" ]] && return 0
  done
  return 1
}

run_stage() {
  local name="$1" code=0
  printf '\n==> %s\n' "$name"
  # Each stage runs in a subshell so a `cd` in one cannot decide where the
  # next one runs.
  ("$(stage_function "$name")") || code=$?
  if ((code != 0)); then
    printf '\nscripts/check: `%s` falhou (exit %d)\n' "$name" "$code" >&2
    exit "$code"
  fi
}

run_stages() {
  preflight "$@"
  local name
  for name in "$@"; do
    run_stage "$name"
  done
}

main() {
  if (($# > 1)); then
    printf 'scripts/check: informe no máximo um alvo\n\n' >&2
    usage
    return "$EXIT_USAGE"
  fi

  local target="${1:-all}"
  cd "$REPO_ROOT"

  case "$target" in
    all)
      run_stages "${RUST_STAGES[@]}" "${FRONTEND_STAGES[@]}"
      ;;
    rust)
      run_stages "${RUST_STAGES[@]}"
      ;;
    frontend)
      run_stages "${FRONTEND_STAGES[@]}"
      ;;
    -h | --help | help)
      usage
      return "$EXIT_USAGE"
      ;;
    *)
      if is_stage "$target"; then
        run_stages "$target"
      else
        printf 'scripts/check: alvo desconhecido `%s`\n\n' "$target" >&2
        usage
        return "$EXIT_USAGE"
      fi
      ;;
  esac

  printf '\nscripts/check: %s — tudo passou.\n' "$target"
}

main "$@"
