#!/usr/bin/env bash
#
# The regression test for the Phase 3.7 incident.
#
# WHAT WENT WRONG. `scripts/note-it-isolated` overrode the four XDG variables
# and nothing else. Note-it is a single-instance `GApplication`, and
# single-instance is a well-known name on the **session bus**: with a daemon
# already running there, the isolated process found the name owned, handed its
# command line over and exited. The real daemon did the work, in the real store.
# A test note ended up in the user's own notes directory.
#
# WHAT THIS TEST DOES. It builds that situation on purpose — a stand-in for the
# user's session, with its own bus and its own store — and then checks that the
# harness cannot reach it.
#
# It has two halves.
#
# The **core** runs anywhere, CI included. It uses a stub in place of the
# note-it binary, because what failed was where the harness *pointed* a process,
# and a stub records exactly that: the environment it was handed and the store it
# wrote to. Every causal step of the incident is asserted.
#
# The **fidelity** half runs only where there is a display and a built binary.
# It puts a genuine `note-it --background` daemon on the stand-in bus, owning the
# real well-known name, and then runs the harness against it. That is the
# incident itself, reproduced end to end. In CI it is skipped out loud rather
# than silently.
#
# Nothing here ever touches the user's own store: the stand-in "real" home is a
# throwaway directory, and the stand-in daemon is given it explicitly.
#
# Usage: scripts/test-isolation
#
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT
readonly HARNESS="$REPO_ROOT/scripts/note-it-isolated"
readonly APPLICATION_ID="io.github.theghols.NoteIt"

FAILURES=0
WORK=""
AMBIENT_BUS_PID=""
AMBIENT_BUS_DIR=""
AMBIENT_BUS_ADDRESS=""
STANDIN_DAEMON_PID=""

pass() { printf '  ok    %s\n' "$1"; }
fail() {
  printf '  FAIL  %s\n' "$1" >&2
  FAILURES=$((FAILURES + 1))
}
skip() { printf '  skip  %s\n' "$1"; }
step() { printf '\n%s\n' "$1"; }

# shellcheck disable=SC2329  # invoked by the EXIT trap below.
cleanup() {
  if [[ -n "$STANDIN_DAEMON_PID" ]]; then kill "$STANDIN_DAEMON_PID" 2>/dev/null || true; fi
  if [[ -n "$AMBIENT_BUS_PID" ]]; then kill "$AMBIENT_BUS_PID" 2>/dev/null || true; fi
  if [[ -n "$AMBIENT_BUS_DIR" && "$AMBIENT_BUS_DIR" == /tmp/note-it-ambient-bus-* ]]; then
    rm -rf "$AMBIENT_BUS_DIR"
  fi
  if [[ -n "$WORK" && "$WORK" == /tmp/note-it-isolation-test-* ]]; then
    rm -rf "$WORK"
  fi
  return 0
}
trap cleanup EXIT

for tool in dbus-daemon dbus-send; do
  command -v "$tool" >/dev/null 2>&1 \
    || { echo "ABORT: $tool is required to test D-Bus isolation" >&2; exit 92; }
done

WORK="$(mktemp -d /tmp/note-it-isolation-test-XXXXXX)"

# How many notes a store holds, answering 0 for a store that is not there.
# `find` on a missing directory exits non-zero, and under `pipefail` that would
# end the test rather than let it report what it found — which is precisely the
# case a broken harness produces.
count_notes() {
  [[ -d "$1" ]] || { printf '0'; return 0; }
  find "$1" -name '*.md' -type f | wc -l
}

# Whether a pid names a process that is still *running*.
#
# `kill -0` only asks whether the pid exists, and a process that has exited but
# not been reaped still does. In a container whose PID 1 does not reap — a CI
# runner, for instance — a stopped `dbus-daemon` lingers as a zombie and
# `kill -0` keeps answering yes, so the state letter from `/proc` is read
# instead. Parsed in bash alone: the second field of `stat` is the command name
# and may contain spaces and parentheses, so everything up to the last `) ` is
# discarded first.
process_is_running() {
  local pid="${1:-}" stat_line state
  [[ -n "$pid" ]] || return 1
  if [[ -r "/proc/$pid/stat" ]]; then
    read -r stat_line < "/proc/$pid/stat" || return 1
    stat_line="${stat_line##*) }"
    state="${stat_line%% *}"
    [[ -n "$state" && "$state" != Z && "$state" != X ]]
    return
  fi
  kill -0 "$pid" 2>/dev/null
}

names_on() {
  DBUS_SESSION_BUS_ADDRESS="$1" dbus-send --session --print-reply=literal \
    --dest=org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus.ListNames 2>/dev/null
}

start_bus() { # $1 = socket dir prefix; sets BUS_ADDRESS_OUT / BUS_PID_OUT / BUS_DIR_OUT
  BUS_DIR_OUT="$(mktemp -d "$1-XXXXXX")"
  local reported=()
  mapfile -t reported < <(
    dbus-daemon --session --address="unix:dir=$BUS_DIR_OUT" \
      --fork --print-address --print-pid 2>/dev/null || true
  )
  BUS_ADDRESS_OUT=""
  BUS_PID_OUT=""
  local line
  for line in "${reported[@]}"; do
    if [[ "$line" == unix:* ]]; then BUS_ADDRESS_OUT="$line"
    elif [[ "$line" =~ ^[0-9]+$ ]]; then BUS_PID_OUT="$line"; fi
  done
  [[ -n "$BUS_ADDRESS_OUT" && -n "$BUS_PID_OUT" ]]
}

# ---------------------------------------------------------------------------
step '1. A stand-in for the user session: its own bus, its own lived-in store.'

REAL_HOME="$WORK/ambient-home"
REAL_STORE="$REAL_HOME/.local/share/note-it/notes"
REAL_STATE="$REAL_HOME/.local/state/note-it"
REAL_CONFIG="$REAL_HOME/.config/note-it"
mkdir -p "$REAL_STORE" "$REAL_STATE" "$REAL_CONFIG" "$REAL_HOME/.cache"

printf -- '---\nnote_it:\n  id: aaaaaaaa\n---\n\numa nota do usuario\n' \
  > "$REAL_STORE/aaaaaaaa-0000-4000-8000-000000000001.md"
printf -- '---\nnote_it:\n  id: bbbbbbbb\n---\n\n= 10 km em m\n' \
  > "$REAL_STORE/bbbbbbbb-0000-4000-8000-000000000002.md"
printf '{"active_layer_mode":"overlay","notes":{}}\n' > "$REAL_STATE/state.json"
printf 'theme = "dark"\n' > "$REAL_CONFIG/config.toml"

start_bus /tmp/note-it-ambient-bus \
  || { echo "ABORT: could not start the stand-in session bus" >&2; exit 92; }
AMBIENT_BUS_ADDRESS="$BUS_ADDRESS_OUT"
AMBIENT_BUS_PID="$BUS_PID_OUT"
AMBIENT_BUS_DIR="$BUS_DIR_OUT"
pass "stand-in session bus running (pid $AMBIENT_BUS_PID)"

if [[ "$AMBIENT_BUS_ADDRESS" == "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
  echo "ABORT: the stand-in bus is the caller's own bus" >&2
  exit 92
fi

# ---------------------------------------------------------------------------
step '2. Fingerprint that store: contents and timestamps.'

# Contents, sizes and modification times of every file under a directory,
# reduced to one hash. Timestamps are included on purpose: "the file says the
# same thing" is a weaker claim than "the file was not written".
fingerprint_of() {
  {
    find "$1" -type f -printf '%p %s %T@\n' | sort
    find "$1" -type f -print0 | sort -z | xargs -0 -r sha256sum
  } | sha256sum | cut -d' ' -f1
}

# The whole ambient home. Used while nothing of the ambient session is running,
# so anything at all changing is the harness leaking.
fingerprint() { fingerprint_of "$REAL_HOME"; }

# Just the notes. Used while a real daemon *is* running, because a running
# application legitimately writes its own `state.json` and caches; what must not
# happen is a note appearing or being rewritten.
fingerprint_notes() { fingerprint_of "$REAL_STORE"; }

BEFORE="$(fingerprint)"
BEFORE_LISTING="$(find "$REAL_HOME" -type f | sort)"
pass "fingerprint taken: ${BEFORE:0:16}"

# ---------------------------------------------------------------------------
step '3. Run the harness with that session as the ambient one.'

ISOLATED_ROOT="$WORK/isolated"
ENV_LOG="$WORK/env.log"
: > "$ENV_LOG"

# A stand-in for the binary: it writes into whatever store its environment names
# and records the environment it was handed, which is the thing under test.
cat > "$WORK/fake-note-it" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
notes="${XDG_DATA_HOME:?}/note-it/notes"
mkdir -p "$notes"
{
  echo "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-}"
  echo "XDG_DATA_HOME=${XDG_DATA_HOME:-}"
  echo "XDG_STATE_HOME=${XDG_STATE_HOME:-}"
  echo "XDG_CACHE_HOME=${XDG_CACHE_HOME:-}"
  echo "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-}"
} >> "${NOTE_IT_ENV_LOG:?}"
case "${1:-}" in
  new)    printf 'nota de teste\n' > "$notes/test-note.md" ;;
  append) printf 'linha acrescentada\n' >> "$notes/test-note.md" ;;
  *)      : ;;
esac
STUB
chmod +x "$WORK/fake-note-it"

run_isolated() {
  env DBUS_SESSION_BUS_ADDRESS="$AMBIENT_BUS_ADDRESS" \
      HOME="$REAL_HOME" \
      NOTE_IT_BINARY="$WORK/fake-note-it" \
      NOTE_IT_ENV_LOG="$ENV_LOG" \
      "$HARNESS" "$@"
}

if run_isolated --root "$ISOLATED_ROOT" -- new > "$WORK/run1.log" 2>&1; then
  pass 'the harness ran with another session as the ambient bus'
else
  fail "the harness refused to run: $(tail -3 "$WORK/run1.log")"
fi

if run_isolated --root "$ISOLATED_ROOT" -- append > "$WORK/run2.log" 2>&1; then
  pass 'a second command reused the same isolated session'
else
  fail "the second command failed: $(tail -3 "$WORK/run2.log")"
fi

# ---------------------------------------------------------------------------
step '4. The note exists in the throwaway store and nowhere else.'

ISOLATED_NOTE="$ISOLATED_ROOT/data/note-it/notes/test-note.md"
if [[ -f "$ISOLATED_NOTE" ]]; then
  pass 'the note was created in the throwaway store'
else
  fail 'the note is not in the throwaway store'
fi

if [[ -f "$ISOLATED_NOTE" ]] && grep -q 'linha acrescentada' "$ISOLATED_NOTE"; then
  pass 'the second command modified that same note'
else
  fail 'the second command did not reach the note in the throwaway store'
fi

if find "$REAL_HOME" -name 'test-note.md' | grep -q .; then
  fail 'THE TEST NOTE REACHED THE AMBIENT STORE — this is the 3.7 incident'
else
  pass 'no test note anywhere in the ambient store'
fi

# ---------------------------------------------------------------------------
step '5. Every environment the harness handed over was the isolated one.'

invocations="$(grep -c '^DBUS_SESSION_BUS_ADDRESS=' "$ENV_LOG" || true)"
if [[ "$invocations" -eq 2 ]]; then
  pass 'the binary was reached exactly twice'
else
  fail "expected 2 invocations, saw $invocations"
fi

if grep -qxF "DBUS_SESSION_BUS_ADDRESS=$AMBIENT_BUS_ADDRESS" "$ENV_LOG"; then
  fail 'the harness handed over the ambient session bus — this is the 3.7 defect'
else
  pass 'no invocation was given the ambient session bus'
fi

if [[ "$(grep -c '^DBUS_SESSION_BUS_ADDRESS=unix:' "$ENV_LOG" || true)" -eq "$invocations" ]]; then
  pass 'every invocation was given a bus address of its own'
else
  fail 'an invocation was given no bus address at all'
fi

if [[ "$(sort -u "$ENV_LOG" | grep -c '^DBUS_SESSION_BUS_ADDRESS=' || true)" -eq 1 ]]; then
  pass 'both commands were given the same private bus'
else
  fail 'the two commands were given different buses'
fi

for variable in XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME; do
  if grep "^$variable=" "$ENV_LOG" | grep -qv "^$variable=$ISOLATED_ROOT/"; then
    fail "$variable pointed outside the throwaway root"
  else
    pass "$variable was inside the throwaway root every time"
  fi
done

# ---------------------------------------------------------------------------
step '6. The ambient store is untouched, contents and timestamps.'

AFTER="$(fingerprint)"
if [[ "$BEFORE" == "$AFTER" ]]; then
  pass "fingerprint unchanged: ${AFTER:0:16}"
else
  fail "the ambient store changed: $BEFORE -> $AFTER"
fi

if [[ "$BEFORE_LISTING" == "$(find "$REAL_HOME" -type f | sort)" ]]; then
  pass 'no file was added to or removed from the ambient store'
else
  fail 'the file listing of the ambient store changed'
fi

# ---------------------------------------------------------------------------
step '7. Stop the isolated session; the ambient one survives it.'

BUS_PID_FILE="$ISOLATED_ROOT/session/bus.pid"
ISOLATED_BUS_PID=""
[[ -r "$BUS_PID_FILE" ]] && ISOLATED_BUS_PID="$(<"$BUS_PID_FILE")"

if process_is_running "$ISOLATED_BUS_PID"; then
  pass "the private bus persisted between commands (pid $ISOLATED_BUS_PID)"
else
  fail 'the private bus did not persist between commands'
fi

run_isolated --root "$ISOLATED_ROOT" --stop > "$WORK/stop.log" 2>&1 \
  || fail "--stop failed: $(tail -3 "$WORK/stop.log")"

if process_is_running "$ISOLATED_BUS_PID"; then
  fail 'the private bus is still running after --stop'
else
  pass 'the private bus was stopped'
fi

if process_is_running "$AMBIENT_BUS_PID" && names_on "$AMBIENT_BUS_ADDRESS" >/dev/null; then
  pass 'the ambient session bus is still running and still answering'
else
  fail 'the ambient session bus did not survive'
fi

# ---------------------------------------------------------------------------
step '8. Fail-closed: no way to make a private bus means no Note-it at all.'

BLOCKED_PATH="$WORK/no-dbus"
mkdir -p "$BLOCKED_PATH"
for tool in mktemp readlink dirname cat grep sed sort find tr sleep rm mkdir env cut; do
  target="$(command -v "$tool" 2>/dev/null || true)"
  [[ -n "$target" ]] && ln -sf "$target" "$BLOCKED_PATH/$tool"
done
ln -sf "$(command -v bash)" "$BLOCKED_PATH/bash"

set +e
env -i PATH="$BLOCKED_PATH" HOME="$REAL_HOME" \
    DBUS_SESSION_BUS_ADDRESS="$AMBIENT_BUS_ADDRESS" \
    NOTE_IT_BINARY="$WORK/fake-note-it" \
    NOTE_IT_ENV_LOG="$WORK/blocked.log" \
    "$(command -v bash)" "$HARNESS" --root "$WORK/blocked" -- new \
    > "$WORK/blocked-run.log" 2>&1
blocked_status=$?
set -e

if [[ "$blocked_status" -eq 92 ]]; then
  pass 'refused with exit 92 when no private bus could be made'
else
  fail "expected exit 92 without dbus-daemon, got $blocked_status"
fi

if [[ -s "$WORK/blocked.log" ]]; then
  fail 'the binary was started even though the bus could not be isolated'
else
  pass 'the binary was never started'
fi

# ---------------------------------------------------------------------------
step '9. Fail-closed: a root inside the real XDG tree is still refused.'

set +e
env HOME="$REAL_HOME" NOTE_IT_BINARY="$WORK/fake-note-it" \
    NOTE_IT_ENV_LOG="$WORK/xdg.log" \
    "$HARNESS" --root "$REAL_HOME/.local/share" -- new > "$WORK/xdg-run.log" 2>&1
xdg_status=$?
set -e

if [[ "$xdg_status" -eq 90 ]]; then
  pass 'refused a --root inside the real XDG tree with exit 90'
else
  fail "expected exit 90 for a root inside the real XDG tree, got $xdg_status"
fi

# ---------------------------------------------------------------------------
step '10. The incident itself, with a genuine daemon owning the name.'

NOTE_IT_BIN=""
for candidate in "$REPO_ROOT/target/debug/note-it" "$REPO_ROOT/target/release/note-it"; do
  [[ -x "$candidate" ]] && { NOTE_IT_BIN="$candidate"; break; }
done

if [[ -z "$NOTE_IT_BIN" ]]; then
  skip 'no note-it binary built; the core above already covers the mechanism'
elif [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
  skip 'no display; a GTK daemon cannot start here (expected in CI)'
else
  # A real Note-it daemon, on the stand-in bus, with the stand-in store. This is
  # the "already running daemon" that made the incident possible.
  env DBUS_SESSION_BUS_ADDRESS="$AMBIENT_BUS_ADDRESS" \
      HOME="$REAL_HOME" \
      XDG_CONFIG_HOME="$REAL_HOME/.config" \
      XDG_DATA_HOME="$REAL_HOME/.local/share" \
      XDG_STATE_HOME="$REAL_HOME/.local/state" \
      XDG_CACHE_HOME="$REAL_HOME/.cache" \
      "$NOTE_IT_BIN" --background > "$WORK/standin-daemon.log" 2>&1 &
  STANDIN_DAEMON_PID=$!

  owned=0
  for _ in $(seq 1 40); do
    if names_on "$AMBIENT_BUS_ADDRESS" | grep -q "$APPLICATION_ID"; then owned=1; break; fi
    process_is_running "$STANDIN_DAEMON_PID" || break
    sleep 0.25
  done

  if [[ "$owned" -eq 1 ]]; then
    pass "a real Note-it daemon owns $APPLICATION_ID on the stand-in bus"

    STANDIN_BEFORE="$(fingerprint_notes)"
    STANDIN_NOTES_BEFORE="$(count_notes "$REAL_STORE")"

    REAL_ISO="$WORK/isolated-real"
    isolated() {
      env DBUS_SESSION_BUS_ADDRESS="$AMBIENT_BUS_ADDRESS" HOME="$REAL_HOME" \
          NOTE_IT_BINARY="$NOTE_IT_BIN" "$HARNESS" --root "$REAL_ISO" "$@"
    }

    isolated -- --background > "$WORK/iso-daemon.log" 2>&1 &
    iso_daemon=$!
    sleep 3
    isolated -- new > "$WORK/iso-new.log" 2>&1 || true
    sleep 2

    # The two assertions the whole phase is about, and the order matters: they
    # run before anything that depends on a flag the broken harness lacked, so
    # this test reproduces the incident rather than stopping short of it.
    iso_notes="$(count_notes "$REAL_ISO/data/note-it/notes")"
    if [[ "$iso_notes" -ge 1 ]]; then
      pass "the new note went to the isolated store ($iso_notes there)"
    else
      fail 'no note was created in the isolated store'
    fi

    if [[ "$(count_notes "$REAL_STORE")" -eq "$STANDIN_NOTES_BEFORE" ]]; then
      pass "the daemon's own store gained nothing ($STANDIN_NOTES_BEFORE notes, unchanged)"
    else
      fail 'THE NOTE REACHED THE ALREADY-RUNNING DAEMON — the 3.7 incident'
      find "$REAL_STORE" -name '*.md' -printf '      %p\n' | sort >&2
    fi

    if [[ "$STANDIN_BEFORE" == "$(fingerprint_notes)" ]]; then
      pass "the daemon's notes are unchanged, contents and timestamps"
    else
      fail "the already-running daemon's notes changed"
      find "$REAL_STORE" -type f -printf '      %p %s %T@\n' | sort >&2
    fi

    if isolated --verify > "$WORK/iso-verify.log" 2>&1; then
      pass 'the isolated instance is on its own private bus'
    else
      fail "--verify could not find the isolated instance: $(tail -2 "$WORK/iso-verify.log")"
    fi

    isolated --stop > "$WORK/iso-stop.log" 2>&1 || true
    wait "$iso_daemon" 2>/dev/null || true

    if process_is_running "$STANDIN_DAEMON_PID" \
      && names_on "$AMBIENT_BUS_ADDRESS" | grep -q "$APPLICATION_ID"; then
      pass 'the already-running daemon is still running and still owns its name'
    else
      fail 'the already-running daemon did not survive the isolated session'
    fi

    env DBUS_SESSION_BUS_ADDRESS="$AMBIENT_BUS_ADDRESS" HOME="$REAL_HOME" \
      "$NOTE_IT_BIN" quit > /dev/null 2>&1 || true
    wait "$STANDIN_DAEMON_PID" 2>/dev/null || true
    STANDIN_DAEMON_PID=""
  else
    skip "the stand-in daemon never claimed the name: $(tail -2 "$WORK/standin-daemon.log")"
    STANDIN_DAEMON_PID=""
  fi
fi

# ---------------------------------------------------------------------------
printf '\n'
if [[ "$FAILURES" -eq 0 ]]; then
  echo 'isolation: all checks passed'
  exit 0
fi
echo "isolation: $FAILURES check(s) failed" >&2
exit 1
