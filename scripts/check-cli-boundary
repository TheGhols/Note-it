#!/usr/bin/env bash
# Fails if the headless CLI ever gains a desktop/UI dependency.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

tree="$(cargo tree -p noteit-cli --edges normal --prefix none)"
if grep -Eq '^(gtk4|gdk4|webkit6|gtk4-layer-shell|wayland($|-)|niri($|-))( |$)' <<<"$tree"; then
  printf '%s\n' "CLI boundary violation: noteit-cli depends on GTK, GDK, WebKitGTK, layer-shell, Wayland or Niri." >&2
  exit 1
fi

if grep -En '(serde_yaml|std::fs::read_dir)' noteit-cli/src/*.rs >/dev/null 2>&1; then
  printf '%s\n' "CLI boundary violation: noteit-cli/src contains direct YAML parsing or directory traversal; all store access must pass through noteit-core." >&2
  exit 1
fi

printf '%s\n' "CLI boundary OK: noteit-cli has no UI dependencies and delegates store operations to noteit-core."
