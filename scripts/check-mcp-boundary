#!/usr/bin/env bash
# Fails if the headless MCP server ever gains a desktop, network or shell
# dependency — or a way to reach the store that is not the Core's.
#
# "No network" is checked four ways, because no one of them is enough:
#
#   the dependency graph   no HTTP, TLS, OAuth, SSE, WebSocket or socket crate
#   the resolved features  Tokio without `net`, so `tokio::net` does not exist
#   this crate's own code  no `std::net`, no socket type, no socket at all
#   the Core it calls      no *internet* API, while keeping its Unix socket
#
# The third was missing until the 4.1R1 audit: `std::net` is in the standard
# library, so a `TcpListener::bind` in a tool handler appears in no dependency
# tree at all. The fourth was missing until 4.1R1.1, and it is the one that
# makes the claim cover the whole path rather than one crate of it — the MCP
# adapter is a thin shell over `noteit-core`, so "the MCP server has no network"
# is only true if the Core it calls into has none either.
#
# That fourth rule has to draw a line the others do not. The Core deliberately
# speaks over a **Unix** socket: that is how a write reaches the instance
# holding the store, and forbidding it would delete the architecture rather
# than protect it. So the rule refuses AF_INET and AF_INET6 by name and leaves
# AF_UNIX alone — and then asserts the Unix mechanism is still there, so the
# rule can never be satisfied by removing the thing it was meant to permit.
#
# `noteit-mcp/tests/mcp_no_network.rs` checks the running process from outside.
# What it can and cannot prove is written down there; the short version is that
# socket *presence* is sound and socket *family* is best-effort, which is
# exactly why the static rules above carry the family guarantee.
#
# `noteit-mcp` is spawned by a host, speaks one protocol on standard input and
# standard output, and writes through the one write authority. Every check
# below is one of those sentences, made mechanical.
#
# The dependency tree is read with `--edges normal`, which is the graph the
# shipped binary is built from. Development dependencies are deliberately out
# of scope: the test harness is a client and the server is not, and a suite
# that drives a real process is allowed things the process itself is not.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

fail() {
  printf 'MCP boundary violation: %s\n' "$*" >&2
  exit 1
}

tree="$(cargo tree -p noteit-mcp --edges normal --prefix none)"

# The crate's own code, with its comments taken off.
#
# Every source rule below is about what the program *does*, and the
# documentation in this crate necessarily talks about the very things the rules
# forbid — it explains why `println!` is not allowed, and that sentence must not
# be the thing that fails the gate.
sources="noteit-mcp/src"
code() {
  # shellcheck disable=SC2016
  find "$sources" -name '*.rs' -print0 \
    | xargs -0 grep -n '' \
    | sed -e 's|//[!/].*||' -e 's|//.*||'
}

offending() {
  local pattern="$1" found
  found="$(code | grep -E "$pattern" || true)"
  [ -n "$found" ] && printf '%s\n' "$found" >&2 && return 0
  return 1
}

# 1. Headless. No compositor, no toolkit, no WebView.
if grep -Eq '^(gtk4|gdk4|webkit6|gtk4-layer-shell|wayland($|-)|niri($|-))( |$)' <<<"$tree"; then
  fail "noteit-mcp depends on GTK, GDK, WebKitGTK, layer-shell, Wayland or Niri."
fi

# 2. Local. The store is a local resource and reaching it over a network is not
#    a feature that was left out — it is a thing this must never grow. An HTTP
#    stack arriving here is how a "just for the inspector" server becomes a
#    listening socket nobody meant to open.
#    The second group arrived with 4.3C. The local embedding provider's
#    upstream world assumes a model is *fetched*: `tokenizers` has an `http`
#    feature that pulls `hf-hub`, `hf-hub` pulls `ureq`, and `model2vec-rs`
#    enables both by default. None of them is in this graph, and this is the
#    line that keeps it that way — obtaining an artifact is
#    `scripts/fetch-embedding-artifact`, run by a person, never by a build.
if grep -Eq '^(reqwest|hyper|hyper-util|axum|tower-http|actix-web|warp|rustls|rustls-pki-types|native-tls|openssl|openssl-sys|oauth2|sse-stream|tungstenite|tokio-tungstenite|socket2|mio|quinn|h2|h3|httparse|http|http-body|http-body-util|trust-dns-resolver|hickory-resolver|ureq|hf-hub|attohttpc|isahc|curl|curl-sys|surf|minreq|ehttp|reqwest-middleware)( |$)' <<<"$tree"; then
  fail "noteit-mcp pulled in an HTTP, TLS, OAuth, SSE, WebSocket or socket stack; this server speaks stdio only."
fi

# 2b. The asynchronous route to a socket, closed at the feature level.
#
#     `tokio::net` exists only when Tokio is built with its `net` feature. That
#     feature is not asked for here, and it must not arrive through unification
#     with some other crate's dependency either — feature unification is
#     graph-wide, so a feature this manifest never names can still be switched
#     on for the build. Asserting the resolved set is what makes
#     `tokio::net::TcpListener` a *compile error* rather than a thing the rule
#     below has to catch by name.
tokio_features="$(cargo tree -p noteit-mcp --edges normal --prefix none -f '{p}\t{f}' \
  | awk -F'\t' '$1 ~ /^tokio v/ { print $2 }' | tr ',' '\n' | sort -u)"
if grep -qx 'net' <<<"$tokio_features"; then
  fail "tokio resolved with its \`net\` feature in noteit-mcp's graph; tokio::net must not exist in this build."
fi

# 3. No second store and no watcher. `serde_yaml` is in the graph through
#    `noteit-core`, which is the one crate entitled to decide what a note file
#    is; what must never appear is a *second* opinion about storage here.
if grep -Eq '^(rusqlite|sqlx|sled|redb|notify|inotify|opentelemetry|tracing-subscriber)( |$)' <<<"$tree"; then
  fail "noteit-mcp pulled in a database, a filesystem watcher or a telemetry exporter."
fi

# 4. The rmcp features actually asked for, stated in one place and checked
#    here, because a convenient `default-features` would quietly bring back
#    everything above.
manifest="noteit-mcp/Cargo.toml"
grep -q 'default-features = false' "$manifest" \
  || fail "noteit-mcp does not disable rmcp's default features."
for forbidden in 'transport-streamable-http' 'server-side-http' 'client-side-sse' '"auth"' '"client"' 'reqwest'; do
  if grep -q -- "$forbidden" "$manifest"; then
    fail "noteit-mcp's manifest enables \`$forbidden\`."
  fi
done

# 5. No filesystem of its own, and no shell. The code may not open a note,
#    walk a directory or start a process: every one of those is a way around
#    the writer lease, the note's identity and the precondition on a write.
offending 'serde_yaml' \
  && fail "noteit-mcp/src parses YAML directly; a note file is noteit-core's to read."
offending 'std::process::(Command|Child)|Command::new|std::fs::|OpenOptions::new' \
  && fail "noteit-mcp/src opens files, walks directories or starts processes directly."

# 5b. And no socket of its own, of any family.
#
#     The rules above are about the dependency graph, and a dependency graph
#     cannot answer this one: `std::net` is in the standard library and is
#     always available, so nothing in a `cargo tree` will ever mention it. A
#     `TcpListener::bind` added to a tool handler would have passed every check
#     this gate had before this line existed.
#
#     Unix sockets are refused here too. The private control socket is real and
#     necessary, and it belongs to `noteit-core`: this crate reaches the
#     authority by calling it, never by opening a socket itself. A second place
#     that speaks to the store over a socket is a second implementation of the
#     handover.
offending '\b(std::net|tokio::net|os::unix::net|socket2|mio::net)\b' \
  && fail "noteit-mcp/src reaches for a network or socket API; this server speaks stdio and calls noteit-core, and nothing else."
offending '\b(TcpListener|TcpStream|UdpSocket|UnixListener|UnixDatagram|UnixStream|ToSocketAddrs|SocketAddr|SocketAddrV4|SocketAddrV6)\b' \
  && fail "noteit-mcp/src names a socket type; this server speaks stdio and calls noteit-core, and nothing else."

# 5c. And neither does the Core it calls into — but only as far as the
#     internet goes.
#
#     The MCP adapter is a thin shell: nearly everything it does happens inside
#     `noteit-core`. A rule that stopped at `noteit-mcp/src` would leave "this
#     server has no network" resting on one crate of a two-crate path.
#
#     The line is drawn at the address family, not at the word "socket". The
#     Core's authority connects to the instance holding the store over a Unix
#     domain socket; that is the design (see ADR-045), and a grep that forbade
#     sockets outright here would demand deleting it.
core_sources="noteit-core/src"
core_code() {
  find "$core_sources" -name '*.rs' -print0 \
    | xargs -0 grep -n '' \
    | sed -e 's|//[!/].*||' -e 's|//.*||'
}
core_offending() {
  local pattern="$1" found
  found="$(core_code | grep -E "$pattern" || true)"
  [ -n "$found" ] && printf '%s\n' "$found" >&2 && return 0
  return 1
}

core_offending '\b(std::net|tokio::net|socket2|mio::net)\b' \
  && fail "noteit-core/src reaches for an internet networking API; the MCP server calls into this crate, and its Unix authority socket is the only socket on that path."
core_offending '\b(TcpListener|TcpStream|UdpSocket|ToSocketAddrs|SocketAddrV4|SocketAddrV6|IpAddr|Ipv4Addr|Ipv6Addr)\b' \
  && fail "noteit-core/src names an internet socket or address type; AF_UNIX is permitted here and AF_INET/AF_INET6 are not."

#     And neither does the embedding provider, which since 4.3C is the third
#     crate on the path from a tool call to a note. It has no Unix socket to
#     permit either: it reads two files and does arithmetic, so the rule here is
#     the flat one the Core's cannot be.
embedding_sources="noteit-embedding-local/src"
embedding_code() {
  find "$embedding_sources" -name '*.rs' -print0 \
    | xargs -0 grep -n '' \
    | sed -e 's|//[!/].*||' -e 's|//.*||'
}
if embedding_code | grep -Eq '\b(std::net|tokio::net|socket2|mio::net|UnixStream|UnixListener|TcpStream|TcpListener|UdpSocket|SocketAddr)\b'; then
  embedding_code | grep -E '\b(std::net|tokio::net|socket2|mio::net|UnixStream|UnixListener|TcpStream|TcpListener|UdpSocket|SocketAddr)\b' >&2
  fail "noteit-embedding-local/src reaches for a socket; the local provider reads files and computes, and has no network of any family."
fi

#     And the permitted mechanism must still exist. Without this, the two rules
#     above would be satisfied perfectly by a Core that had lost the authority
#     handover altogether — passing a network check by deleting the feature it
#     was written to protect.
grep -q 'std::os::unix::net::UnixStream' "$core_sources/authority.rs" \
  || fail "noteit-core/src/authority.rs no longer connects over a Unix socket; the rules above permit AF_UNIX precisely because this is how a write reaches the instance holding the store."

# 6. It never runs the CLI and reads its answer. The chain has to stay typed.
offending 'noteit_cli|--json' \
  && fail "noteit-mcp/src reaches for the command line instead of the domain."

# 7. Standard output belongs to the protocol. A single print corrupts the
#    JSON-RPC stream, so the code may not contain one at all — `mcp_surface`
#    proves the running process is clean, and this proves nobody added one.
offending '(^|[^a-z_])(println!|print!|dbg!)' \
  && fail "noteit-mcp/src writes to standard output; stdout belongs to the MCP protocol."

# 8. Every mutation of an existing note takes its precondition. There is one
#    place in this crate that builds a conditional write, and it is the type
#    that cannot exist without a revision. A second construction site is how a
#    tool would come to write unconditionally.
built="$(code | grep -cE 'WriteOperation::MutateNote' || true)"
if [ "$built" != "1" ]; then
  code | grep -E 'WriteOperation::MutateNote' >&2 || true
  fail "MutateNote is built in $built places; every mutation must go through ExistingNoteMutation."
fi

# 9. And it is required *in the type*, not merely checked somewhere.
#
#    Three things are asserted, because each one alone can be got around:
#    the one struct that reaches the store holds a parsed revision and not an
#    option; every tool input that names an existing note is declared by the
#    one macro that hardcodes the field; and no input anywhere deserializes an
#    optional revision. The output side is deliberately out of scope — a
#    `revision_conflict` answers with `Option<String>` fields because a refusal
#    that is not a conflict has nothing to put in them.
grep -q 'expected_revision: NoteRevision,' "$sources/domain.rs" \
  || fail "ExistingNoteMutation no longer holds a parsed, non-optional revision."
grep -q 'pub expected_revision: RevisionArgument,' "$sources/contract.rs" \
  || fail "the mutation input macro no longer requires expected_revision."
declared="$(grep -c '^mutation_input! {' "$sources/contract.rs" || true)"
[ "$declared" = "8" ] \
  || fail "there are $declared mutation inputs and the catalogue documents 8; a new one must go through mutation_input!."
offending 'Option *< *NoteRevision|Option *< *RevisionArgument' \
  && fail "an optional precondition type appeared at the MCP boundary."

# 10. Core I/O enters through one door, and the door is offloaded.
#
#     `OffThread` already makes it impossible to *call* a store function in
#     `domain.rs` on the reactor: the witness has one constructor and it lives
#     inside the closure `spawn_blocking` runs. What it cannot do is stop
#     somebody opening a second door — a sixteenth tool that skips `domain.rs`
#     and calls `noteit_core` directly from its handler would satisfy every
#     type in this crate and still block the protocol.
#
#     So the rule is about *where* Core I/O may be named. `domain.rs` is the
#     adapter and is allowed to; nothing else in the crate is. This is not a
#     ban on `noteit_core` — `server.rs` legitimately builds a `NoteMutation`
#     and passes a `Uuid`, and those touch no file. It names the handles and
#     the calls that reach the store.
#
#     The module paths are listed as well as the call names, because a `use`
#     that renames one would otherwise walk straight past a rule that only knew
#     the original spelling — `use noteit_core::context as engine;` and then
#     `engine::retrieve(...)`. Naming the module catches the import itself,
#     whatever the caller decides to call it afterwards.
io_surface='(noteit_core *:: *(context|authority|storage)|\b(NoteItCore|StorageManager|open_read_only(_at)?|from_storage|authority::|perform_at|read_note|list_summaries|list_notes(_by_recency)?(_with_warnings)?|search_notes(_filtered)?|list_tasks|list_trash|metadata_catalog(_with_warnings)?|study_state|resolve_note_id|resolve_trash_id|save_note_atomic|move_note_to_trash|ensure_directories|context::retrieve|write::execute|commit_addressed)\b)'

#     Since 4.3C the adapter is two files. `semantic.rs` holds the provider,
#     the index and the lifecycle that outlives a request, and it necessarily
#     names the Core: indexing *is* reading notes. It is inside the rule rather
#     than exempt from it — the entry point takes the same `OffThread` witness
#     every other Core call here takes, which is asserted below, so "Core I/O
#     only where the offload is proven" is still what this rule enforces.
outside_the_adapter() {
  find "$sources" -name '*.rs' ! -name 'domain.rs' ! -name 'semantic.rs' -print0 \
    | xargs -0 grep -n '' \
    | sed -e 's|//[!/].*||' -e 's|//.*||'
}
found="$(outside_the_adapter | grep -E "$io_surface" || true)"
if [ -n "$found" ]; then
  printf '%s\n' "$found" >&2
  fail "Core store access is named outside noteit-mcp/src/domain.rs; every store operation must go through the offloaded adapter so it cannot run on the protocol thread."
fi

#     And the door must still be a door. Without these, the rule above would be
#     satisfied perfectly by a `domain.rs` that had stopped offloading at all —
#     passing an offload check by deleting the offload.
grep -q 'tokio::task::spawn_blocking' "$sources/domain.rs" \
  || fail "noteit-mcp/src/domain.rs no longer hands Core work to spawn_blocking; the rule above allows it to name the store precisely because this is how that work leaves the reactor."
grep -q 'fn reader(&self, _off: &OffThread)' "$sources/domain.rs" \
  || fail "Store::reader no longer requires the OffThread witness; a read could run on the protocol thread again."
grep -q 'fn perform(_off: &OffThread' "$sources/domain.rs" \
  || fail "the write path no longer requires the OffThread witness; a write could run on the protocol thread again."
grep -q 'pub struct OffThread(());' "$sources/domain.rs" \
  || fail "the OffThread witness no longer has a module-private field; anything could build one."
grep -q '_off: &crate::domain::OffThread,' "$sources/semantic.rs" \
  || fail "noteit-mcp/src/semantic.rs no longer requires the OffThread witness; indexing could run on the protocol thread."
#     Two mentions of the empty-tuple form: the declaration above, and the one
#     construction inside off_reactor. A third is a second way to mint the
#     proof, which would make it prove nothing.
minted="$(grep -c 'OffThread(())' "$sources/domain.rs" || true)"
if [ "$minted" != "2" ]; then
  grep -n 'OffThread(())' "$sources/domain.rs" >&2 || true
  fail "the OffThread witness is declared and built in $minted places rather than 2; exactly one construction, inside off_reactor, is what makes it proof of anything."
fi

# 11. Every public sentence is a constant, and arguments are read through this
#     crate's own extractor.
#
#     Phase 4.2R made this true of everything the *domain* says: a `message` is
#     a `&'static str` chosen by a `code`, so a runtime-built string cannot be
#     put there. It was not true one layer earlier. Arguments are deserialised
#     into a tool's input type before any handler in this crate runs, and the
#     SDK's `Parameters<T>` answers a failure with `serde_json`'s sentence —
#     which quotes the value it did not understand, in full. Three hundred
#     kilobytes of wrong-typed argument came back as three hundred kilobytes,
#     measured on the wire.
#
#     The fix is `crate::params::SafeParameters`, and these rules are what stop
#     a sixteenth or seventeenth tool from quietly going back to the SDK's.

#     11a. The SDK's extractor may not be named here at all. `server.rs`
#          imports ours under the name `Parameters`, which is also the name the
#          `#[tool]` macro looks for when it derives a tool's input schema — so
#          a new tool written the ordinary way gets the safe one without
#          knowing it exists, and the only way back to the unsafe one is to
#          name it.
offending 'wrapper::Parameters|rmcp( |)::(.*::)?Parameters' \
  && fail "noteit-mcp/src names rmcp's own Parameters extractor; a bad argument would come back quoted at whatever length it arrived. Use crate::params::SafeParameters."

#     11b. And the name every tool signature uses must still be bound to ours.
#          Without this the rule above is satisfied perfectly by deleting the
#          import and letting the tools fail to compile — or, worse, by binding
#          `Parameters` to something else entirely.
grep -q '^use crate::params::SafeParameters as Parameters;$' "$sources/server.rs" \
  || fail "noteit-mcp/src/server.rs no longer binds Parameters to crate::params::SafeParameters; every tool's arguments must come through the safe extractor."

#     11c. The safe extractor must still throw the error away. One
#          `FromContextPart` implementation, and a refusal that is the
#          constant. A `parse` that started describing what it refused would
#          satisfy 11a and 11b and leak anyway.
grep -q 'pub const INVALID_ARGUMENTS: &str' "$sources/params.rs" \
  || fail "noteit-mcp/src/params.rs no longer answers a bad argument with a constant."
extractors="$(grep -c 'impl<S, P> FromContextPart' "$sources/params.rs" || true)"
[ "$extractors" = "1" ] \
  || fail "noteit-mcp/src/params.rs declares $extractors argument extractors rather than 1; exactly one is what makes it the boundary."

#     11d. No sentence in this crate is built at run time.
#
#          `format!` is how a library's error, a path or an argument becomes a
#          string, and every string this crate can put on the wire is written
#          in the source. `main.rs` is excluded and only `main.rs`: it writes
#          to standard error, for a person, and never to the protocol — see
#          rule 7, which is what keeps it off standard output.
built_at_runtime() {
  find "$sources" -name '*.rs' ! -name 'main.rs' -print0 \
    | xargs -0 grep -n '' \
    | sed -e 's|//[!/].*||' -e 's|//.*||' \
    | grep -E '(^|[^a-z_])format!' || true
}
found="$(built_at_runtime)"
if [ -n "$found" ]; then
  printf '%s\n' "$found" >&2
  fail "noteit-mcp/src builds a sentence at run time; every message this server publishes is a literal, so a library's error text cannot become one."
fi

#     11e. And the method name of an unroutable request is not echoed either.
#          The SDK's default `on_custom_request` answers with the method string
#          the client sent, at the length the client chose — the same class of
#          leak, one layer above the arguments.
grep -q 'fn on_custom_request' "$sources/server.rs" \
  || fail "noteit-mcp/src/server.rs no longer overrides on_custom_request; the SDK's default answers an unknown method by echoing its name."

printf '%s\n' "MCP boundary OK: noteit-mcp is headless, opens no socket at all, reaches the Core over its Unix authority socket and nothing else, reaches the store only through the offloaded adapter, reads every argument through its own extractor and publishes no sentence it did not write, and every mutation of an existing note requires a revision."
